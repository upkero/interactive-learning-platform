{
  "uid":"grasp-solver", "title":"Решатель", "schemaVersion":39, "version":1,
  "panels":[
    {"id":1,"type":"timeseries","title":"Время части p50/p95","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.5, sum by (le, outcome) (rate(part_processing_duration_seconds_bucket[1h])))","legendFormat":"{{outcome}} p50"},{"refId":"B","expr":"histogram_quantile(0.95, sum by (le, outcome) (rate(part_processing_duration_seconds_bucket[1h])))","legendFormat":"{{outcome}} p95"}]},
    {"id":2,"type":"timeseries","title":"Время этапов p95","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, stage) (rate(part_stage_duration_seconds_bucket[1h])))","legendFormat":"{{stage}}"}]},
    {"id":3,"type":"timeseries","title":"Вызовы моделей","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (purpose, model, provider) (rate(llm_complete_requests_total[5m]))","legendFormat":"{{purpose}} {{model}} {{provider}}"}]},
    {"id":4,"type":"timeseries","title":"Время модели p95","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, purpose, model, provider) (rate(llm_complete_duration_seconds_bucket[5m])))","legendFormat":"{{purpose}} {{model}} {{provider}}"}]},
    {"id":5,"type":"timeseries","title":"Токены и кэш","gridPos":{"x":0,"y":16,"w":24,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (purpose, model, provider) (rate(llm_complete_usage_input_tokens_sum[5m]))","legendFormat":"input {{purpose}} {{model}} {{provider}}"},{"refId":"B","expr":"sum by (purpose, model, provider) (rate(llm_complete_usage_output_tokens_sum[5m]))","legendFormat":"output {{purpose}} {{model}} {{provider}}"},{"refId":"C","expr":"sum by (purpose, model, provider) (rate(llm_complete_usage_cache_read_input_tokens_sum[5m]))","legendFormat":"cache read {{purpose}} {{model}} {{provider}}"},{"refId":"D","expr":"sum by (purpose, model, provider) (rate(llm_complete_usage_cache_creation_input_tokens_sum[5m]))","legendFormat":"cache write {{purpose}} {{model}} {{provider}}"}]},
    {"id":6,"type":"timeseries","title":"Решения резолвера","gridPos":{"x":0,"y":24,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (decision) (rate(resolver_decisions_total[1h]))","legendFormat":"{{decision}}"}]},
    {"id":7,"type":"timeseries","title":"Вердикты судьи","gridPos":{"x":12,"y":24,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (accepted, attempt) (rate(judge_verdicts_total[1h]))","legendFormat":"{{accepted}} {{attempt}}"}]},
    {"id":8,"type":"timeseries","title":"Исходы заданий","gridPos":{"x":0,"y":32,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (type, outcome) (rate(quiz_generated_total[1h]))","legendFormat":"{{type}} {{outcome}}"}]},
    {"id":9,"type":"timeseries","title":"Задачи Celery","gridPos":{"x":12,"y":32,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (task, state) (rate(celery_tasks_total[5m]))","legendFormat":"{{task}} {{state}}"}]},
    {"id":10,"type":"timeseries","title":"Время задач Celery p95","gridPos":{"x":0,"y":40,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, task) (rate(celery_task_duration_seconds_bucket[5m])))","legendFormat":"{{task}}"}]},
    {"id":11,"type":"timeseries","title":"Исключения виджетов и слияния библиотеки","gridPos":{"x":12,"y":40,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(widgets_excluded_total[1h]))","legendFormat":"excluded"},{"refId":"B","expr":"sum by (outcome) (rate(library_merges_total[1h]))","legendFormat":"merge {{outcome}}"}]}
  ]
