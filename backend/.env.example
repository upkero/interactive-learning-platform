# ==============================================================================
# Grasp — Environment Variables Template (.env.example)
# Copy this file to .env and adjust the values for your environment.
# DO NOT commit real secrets (.env) to version control!
#
# ВАЖНО: по умолчанию адреса сервисов (db, redis, minio, ollama) указаны так,
# как их видят контейнеры внутри Docker Compose. Для локального запуска бэкенда
# без Docker замените имя сервиса на localhost (например, "db" -> "localhost").
# ==============================================================================

# +--------------------------------------------------------------------------+
# | INFRASTRUCTURE: POSTGRESQL                                               |
# +--------------------------------------------------------------------------+
# Переменные для инициализации контейнера базы данных в compose
POSTGRES_DB="grasp"
POSTGRES_USER="grasp"
POSTGRES_PASSWORD="grasp_dev_password"

# +--------------------------------------------------------------------------+
# | APPLICATION: LOGGING SETTINGS                                            |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.logging.LoggingSettings
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"
# Log format: json (production/compose) | text (local development)
LOG_FORMAT="text"

# +--------------------------------------------------------------------------+
# | APPLICATION: GENERAL & DATABASE SETTINGS                                 |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.app.AppSettings
ENVIRONMENT="development"
PUBLIC_APP_URL="http://localhost:3000"
CORS_ALLOW_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# Inside docker compose use service name "db"; for a local run without Docker use "localhost"
DB_URL="postgresql+asyncpg://grasp:grasp_dev_password@db:5432/grasp"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_USE_NULL_POOL=false

# +--------------------------------------------------------------------------+
# | APPLICATION: AUTH & SECURITY SETTINGS                                    |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.auth.AuthSettings
# ОБЯЗАТЕЛЬНЫЙ СЕКРЕТ: ключ подписи JWT (минимум 32 символа)
AUTH_JWT_SECRET="dev-jwt-secret-key-must-be-at-least-32-chars-long"
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_NAME="grasp_session"

# +--------------------------------------------------------------------------+
# | APPLICATION: S3 / MINIO STORAGE SETTINGS                                 |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.storage.StorageSettings
# Учётные данные MinIO root (требуются для compose и minio-init)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
# In docker compose use "http://minio:9000" (frontend/browser use the public URL below)
S3_ENDPOINT_URL="http://minio:9000"
S3_PUBLIC_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_REGION_NAME="us-east-1"
S3_BUCKET_DOCUMENTS="documents"
S3_BUCKET_IMAGES="images"
S3_PRESIGN_TTL_SECONDS=3600

# +--------------------------------------------------------------------------+
# | APPLICATION: CELERY & REDIS QUEUE SETTINGS                               |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.celery.CelerySettings
# Redis DB 0: брокер задач Celery
# Inside docker compose use "redis://redis:6379/0"; without Docker use "redis://localhost:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"

# +--------------------------------------------------------------------------+
# | APPLICATION: REDIS PROGRESS STREAM SETTINGS                              |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.progress.ProgressSettings
# Redis DB 1: стримы прогресса генерации (отдельная база, чтобы FLUSHDB не ломал очередь)
# Inside docker compose use "redis://redis:6379/1"; without Docker use "redis://localhost:6379/1"
REDIS_PROGRESS_URL="redis://redis:6379/1"
REDIS_PROGRESS_STREAM_MAXLEN=1000
REDIS_PROGRESS_STREAM_TTL_SECONDS=86400

# +--------------------------------------------------------------------------+
# | APPLICATION: UPLOAD LIMITS SETTINGS                                      |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.upload.UploadSettings
# Лимиты загрузки: размер PDF/DOCX (50MB), Markdown (5MB), страницы (300)
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_MARKDOWN_BYTES=5242880
UPLOAD_MAX_PAGES=300
UPLOAD_MAX_UNZIPPED_BYTES=209715200

# +--------------------------------------------------------------------------+
# | APPLICATION: QUOTA SETTINGS                                              |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.quota.QuotaSettings
QUOTA_DEFAULT_MONTHLY_LIMIT=20

# +--------------------------------------------------------------------------+
# | APPLICATION: MAIN LLM SETTINGS (CLAUDE / OLLAMA)                         |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.llm.LLMSettings
# Provider: anthropic | openai_compatible | ollama
LLM_PROVIDER="anthropic"            # anthropic | openai_compatible | ollama
LLM_MODEL="claude-sonnet-5-5"
LLM_API_KEY="sk-ant-..."
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# +--------------------------------------------------------------------------+
# | APPLICATION: CHEAP LLM SETTINGS                                          |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.llm.CheapLLMSettings
# Всё, что не задано, берётся из основного LLM_*-профиля (resolve(fallback)).
LLM_CHEAP_MODEL="claude-haiku-4-5"  # остальное берётся из LLM_*
