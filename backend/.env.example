# Copy this file to .env and adjust the values for your environment.

# +--------------------------------------------------------------------------+
# | INFRASTRUCTURE: POSTGRES                                                  |
# +--------------------------------------------------------------------------+
POSTGRES_DB="db_name"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_password"

# +--------------------------------------------------------------------------+
# | APPLICATION: LOGGING SETTINGS                                             |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.logging.LoggingSettings.
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"

# Log format: json (production) | text (local development)
LOG_FORMAT="json"

# +--------------------------------------------------------------------------+
# | APPLICATION: DATABASE SETTINGS                                            |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.common.Settings.
# Inside docker compose use service name "db"; outside use "localhost".
DB_URL="postgresql+asyncpg://postgres:your_secure_password@db:5432/db_name"

# +--------------------------------------------------------------------------+
# | APPLICATION: LLM SETTINGS                                                 |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.llm.LLMSettings.
# Provider profile: openai | openai_compatible | ollama
LLM_PROVIDER="ollama"
LLM_MODEL="qwen2.5:7b"
# LLM_API_KEY="your_api_key"
# Inside docker compose use service name "ollama"; outside use "localhost".
LLM_BASE_URL="http://ollama:11434/v1"
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=1024
# LLM_REASONING_EFFORT=
# LLM_PRICE_PROMPT_PER_1M=
# LLM_PRICE_COMPLETION_PER_1M=
