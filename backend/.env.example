# ==============================================================================
# Grasp — Environment Variables Template (.env.example)
# Copy this file to .env and adjust the values for your environment.
# DO NOT commit real secrets (.env) to version control!
#
# ВАЖНО: по умолчанию адреса сервисов (db, redis, minio, ollama) указаны так,
# как их видят контейнеры внутри Docker Compose. Для локального запуска бэкенда
# без Docker замените имя сервиса на localhost (например, "db" -> "localhost").
# ==============================================================================

# +--------------------------------------------------------------------------+
# | INFRASTRUCTURE: POSTGRESQL                                               |
# +--------------------------------------------------------------------------+
# Переменные для инициализации контейнера базы данных в compose
POSTGRES_DB="grasp"
POSTGRES_USER="grasp"
POSTGRES_PASSWORD="grasp_dev_password"

# +--------------------------------------------------------------------------+
# | APPLICATION: LOGGING SETTINGS                                            |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.logging.LoggingSettings
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"
# Log format: json (production/compose) | text (local development)
LOG_FORMAT="text"

# Observability. Set a strong, unique password before starting Grafana.
GF_SECURITY_ADMIN_PASSWORD="replace-with-a-strong-grafana-password"
# Production only: replace grasp.example with the domain configured in Nginx and the TLS certificate.
GF_SERVER_ROOT_URL="https://grafana.grasp.example/"
OBSERVABILITY_WORKER_METRICS_PORT=9101
# Compose configures a writable temporary directory automatically. For a local
# prefork worker (even with concurrency=1) set this to a pre-existing writable directory.
# PROMETHEUS_MULTIPROC_DIR="/tmp/grasp-prometheus"

# +--------------------------------------------------------------------------+
# | APPLICATION: GENERAL & DATABASE SETTINGS                                 |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.app.AppSettings
ENVIRONMENT="development"
PUBLIC_APP_URL="http://localhost:3000"
# Inside docker compose use service name "db"; for a local run without Docker use "localhost"
DB_URL="postgresql+asyncpg://grasp:grasp_dev_password@db:5432/grasp"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_USE_NULL_POOL=false

# +--------------------------------------------------------------------------+
# | APPLICATION: AUTH & SECURITY SETTINGS                                    |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.auth.AuthSettings
# ОБЯЗАТЕЛЬНЫЙ СЕКРЕТ: ключ подписи JWT (минимум 32 символа)
AUTH_JWT_SECRET="dev-jwt-secret-key-must-be-at-least-32-chars-long"
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_NAME="grasp_session"
# Settings from src.app.core.settings.rate_limit.RateLimitSettings
# Shared authentication limits: Redis DB 2. For local runs use redis://localhost:6379/2.
RATE_LIMIT_STORAGE_URI="redis://redis:6379/2"

# +--------------------------------------------------------------------------+
# | APPLICATION: S3 / MINIO STORAGE SETTINGS                                 |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.storage.StorageSettings
# Учётные данные MinIO root (требуются для compose и minio-init)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
# In docker compose use "http://minio:9000" (frontend/browser use the public URL below)
S3_ENDPOINT_URL="http://minio:9000"
S3_PUBLIC_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_REGION_NAME="us-east-1"
S3_BUCKET_DOCUMENTS="documents"
S3_BUCKET_IMAGES="images"
S3_PRESIGN_TTL_SECONDS=3600

# Каталог данных MinIO на хосте (интерполяция compose).
# Обязан быть XFS-каталогом — разовая настройка описана в docs/minio-xfs.md.
MINIO_DATA_DIR="/srv/minio-data"

# +--------------------------------------------------------------------------+
# | APPLICATION: CELERY & REDIS QUEUE SETTINGS                               |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.celery.CelerySettings
# Redis DB 0: брокер задач Celery
# Inside docker compose use "redis://redis:6379/0"; without Docker use "redis://localhost:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"

# Stub pipeline is available now; real requires story 2.7.
SOLVER_PIPELINE="stub"

# +--------------------------------------------------------------------------+
# | APPLICATION: REDIS PROGRESS STREAM SETTINGS                              |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.progress.ProgressSettings
# Redis DB 1: стримы прогресса генерации (отдельная база, чтобы FLUSHDB не ломал очередь)
# Inside docker compose use "redis://redis:6379/1"; without Docker use "redis://localhost:6379/1"
REDIS_PROGRESS_URL="redis://redis:6379/1"
REDIS_PROGRESS_STREAM_MAXLEN=1000
REDIS_PROGRESS_STREAM_TTL_SECONDS=86400
REDIS_PROGRESS_SOCKET_TIMEOUT=25

# +--------------------------------------------------------------------------+
# | APPLICATION: SMTP NOTIFICATIONS (development Mailpit only)                |
# +--------------------------------------------------------------------------+
# For production, set SMTP_ENABLED=false until an external SMTP is configured.
# Never use SMTP_HOST=mailpit in production. Configure SMTP_FROM_EMAIL for your domain.
SMTP_ENABLED=true
SMTP_HOST="mailpit"
SMTP_PORT=1025
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@example.com"
SMTP_USE_TLS=false
SMTP_START_TLS=false
SMTP_TIMEOUT=10
SMTP_NOTIFICATION_TTL_SECONDS=604800

# +--------------------------------------------------------------------------+
# | APPLICATION: UPLOAD LIMITS SETTINGS                                      |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.upload.UploadSettings
# Лимиты загрузки: размер PDF/DOCX (50MB), Markdown (5MB), страницы (300)
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_MARKDOWN_BYTES=5242880
UPLOAD_MAX_PAGES=300
UPLOAD_MAX_UNZIPPED_BYTES=209715200

# Document parsing and approximate token accounting (calibration must be verified against the model).
TOKENS_ENCODING="o200k_base"
# Measured against Claude Sonnet 4.6. See evals/token_calibration.json.
TOKENS_CALIBRATION=1.4143
SPLIT_MAX_TOKENS=22000
INGEST_MAX_IMAGES=40
INGEST_IMAGE_CONCURRENCY=4
# INGEST_DOCLING_ARTIFACTS_PATH="/app/artifacts"

# +--------------------------------------------------------------------------+
# | APPLICATION: DOCUMENT PROCESSING LIMITS                                  |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.processing.ProcessingSettings
# How many documents of one user may be in processing at once (story 1.4.13).
PROCESSING_MAX_ACTIVE_DOCUMENTS=2

# +--------------------------------------------------------------------------+
# | APPLICATION: DOCUMENT SPLITTING LIMITS                                   |
# +--------------------------------------------------------------------------+
INGEST_SPLIT_TARGET_TOKENS=15000
INGEST_SPLIT_MAX_TOKENS=22000

# +--------------------------------------------------------------------------+
# | APPLICATION: WIDGET REPORTS                                              |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.reports.ReportsSettings
# Distinct reports after which a widget is excluded from search and parts.
REPORTS_EXCLUDE_THRESHOLD=3

# +--------------------------------------------------------------------------+
# | APPLICATION: QUOTA SETTINGS                                              |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.quota.QuotaSettings
QUOTA_DEFAULT_MONTHLY_LIMIT=20

# +--------------------------------------------------------------------------+
# | APPLICATION: SEED SETTINGS (demo data)                                   |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.seed.SeedSettings
# Password assigned to alice@example.com / bob@example.com by `python -m src.cli seed-dev`.
# No default on purpose: set it explicitly for every environment.
SEED_PASSWORD="dev-seed-password"

# +--------------------------------------------------------------------------+
# | APPLICATION: MAIN LLM SETTINGS                                           |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.llm.LLMSettings
# Provider: anthropic | openai_compatible | ollama
# Default is local Ollama (no key needed). For production switch to
# "anthropic" and set a real key — it must NOT be committed anywhere.
LLM_PROVIDER="ollama"
LLM_MODEL="llama3.2"
# API key. Leave empty for provider "ollama"; required for "anthropic"
# and "openai_compatible".
# LLM_API_KEY=""
# Base URL for openai_compatible providers (Ollama, OpenRouter, a proxy).
# Inside docker compose use the service name; without Docker use localhost.
# Empty means the official OpenAI API.
LLM_BASE_URL="http://ollama:11434/v1"
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# +--------------------------------------------------------------------------+
# | APPLICATION: CHEAP LLM SETTINGS                                          |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.llm.CheapLLMSettings
# Everything not set is taken from the main LLM_* profile (resolve(fallback)).
# If LLM_CHEAP_PROVIDER differs from the main provider, credentials and
# base URL are NOT inherited — set LLM_CHEAP_API_KEY/LLM_CHEAP_BASE_URL.
LLM_CHEAP_MODEL="llama3.2"
# LLM_CHEAP_PROVIDER=anthropic
# LLM_CHEAP_API_KEY=""
# LLM_CHEAP_BASE_URL=""
# LLM_CHEAP_TIMEOUT_SECONDS=60
# LLM_CHEAP_MAX_RETRIES=2
